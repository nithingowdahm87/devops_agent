# ============================================================
# DevOps Agent V14.0 — Environment Variables
# Copy this file: cp .env.example .env
# Fill in your real values in .env — NEVER commit .env
# ============================================================

# ── LOCAL LLM (OLLAMA-ONLY) ─────────────────────────────────
# Ollama runs a local OpenAI-compatible server at http://localhost:11434/v1
#
# Install (Linux/Mac):
#   curl -fsSL https://ollama.com/install.sh | sh
#
# Recommended models for 8 GB RAM:
#   - llama3.2:3b   (default here, good quality, fits 8 GB)
#   - llama3.2:1b   (very light, if RAM is tight)
#
# Pull your chosen model before running the agent:
#   ollama pull llama3.2:3b
#
# This name is passed directly to /v1/chat/completions.
OLLAMA_MODEL=llama3.2:1b
# Any non-empty value is fine; Ollama ignores it but the client requires a key.
OLLAMA_API_KEY=ollama

# ── CI/CD & GITOPS SECRETS ───────────────────────────────────
# Required for GitOps automated PR generation and CI workflows
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPO=your_org/your_gitops_repo
DOCKERHUB_USERNAME=your_dockerhub_user
DOCKERHUB_TOKEN=your_dockerhub_token

# ── GENERATION PARAMS ────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# ── PIPELINE MODE ────────────────────────────────────────────
# Options: dev | prod
PIPELINE_ENV=prod
