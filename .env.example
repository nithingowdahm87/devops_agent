# ============================================================
# DevOps Agent — Environment Variables
# Copy this file: cp .env.example .env
# Fill in your real values in .env — NEVER commit .env
# ============================================================

# ── LLM MODE SELECTOR ────────────────────────────────────────
# Choose ONE primary mode:
#   local   = llama.cpp / Ollama local server
#   kimchi  = Kimchi CLI API (OpenAI-compatible, uses your logged-in token)
#   remote  = External API providers (Groq, Gemini, Cerebras, etc.)
LLM_PRIMARY=kimchi

# ── KIMCHI CLI API (recommended — uses your existing login) ──
# Auto-detects token from `kimchi login` or ~/.config/kimchi/harness/auth.json
# Set KIMCHI_API_KEY only if you want to override the auth.json token.
# KIMCHI_API_KEY=your_token_here
KIMCHI_MODEL=kimi-k2.6

# ── LOCAL LLM (llama.cpp / llama-server / Ollama) ───────────
# Only needed when LLM_PRIMARY=local
LLAMACPP_MODEL=qwen-coder-1.5b.gguf
LLAMACPP_API_KEY=none

# ── REMOTE PROVIDERS (only needed when LLM_PRIMARY=remote) ───
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=your_google_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

CEREBRAS_API_KEY=your_cerebras_key_here
CEREBRAS_MODEL=llama3.1-8b

NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=deepseek/deepseek-r1-0528:free

# Fallback order when a provider fails (comma-separated)
LLM_FALLBACK_ORDER=

# ── CI/CD & GITOPS SECRETS ───────────────────────────────────
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPO=your_org/your_gitops_repo
DOCKERHUB_USERNAME=your_dockerhub_user
DOCKERHUB_TOKEN=your_dockerhub_token

# ── GENERATION PARAMS ────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# ── PIPELINE MODE ────────────────────────────────────────────
# Options: dev | prod
PIPELINE_ENV=prod
