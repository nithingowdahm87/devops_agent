# ============================================================
# DevOps Agent — Environment Variables (NVIDIA Only)
# Copy this file: cp .env.example .env
# Fill in your real values in .env — NEVER commit .env
# ============================================================

# ── LLM PROVIDER ────────────────────────────────────────────
# Only NVIDIA is supported. Set NVIDIA_API_KEY to use the agent.
NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# ── GENERATION PARAMS ────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3

# ── PIPELINE MODE ────────────────────────────────────────────
# Options: dev | prod
PIPELINE_ENV=prod

# ── LOGGING ──────────────────────────────────────────────────
LOG_JSON=false