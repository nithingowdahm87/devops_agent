# ============================================================
# DevOps Agent V14.0 — Environment Variables
# Copy this file: cp .env.example .env
# Fill in your real keys in .env — NEVER commit .env
# ============================================================

# ── PRIMARY MODELS ───────────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_key_here
GROQ_API_KEY=your_groq_key_here
NVIDIA_API_KEY=your_nvidia_nim_key_here
CEREBRAS_API_KEY=your_cerebras_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ── MODEL ROUTING STRATEGY ───────────────────────────────────
# Options: roundrobin | fastest | cheapest | quality | fallback
LLM_STRATEGY=fallback

# ── PRIMARY / FALLBACK ORDER ─────────────────────────────────
# Comma-separated. Agent tries each in order on failure/timeout.
# Available: gemini | groq | nvidia | cerebras | openrouter | huggingface
LLM_PRIMARY=groq
LLM_FALLBACK_ORDER=gemini,cerebras,nvidia,openrouter,huggingface

# ── PER-PROVIDER MODEL PINS ──────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash-exp
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
CEREBRAS_MODEL=llama3.1-70b
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── GENERATION PARAMS ────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# ── PIPELINE MODE ────────────────────────────────────────────
# Options: dev | prod
PIPELINE_ENV=prod
