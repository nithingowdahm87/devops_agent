{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHub Actions Workflow Schema (Hardened)",
  "type": "object",
  "required": [
    "on",
    "jobs"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "on": {
      "type": "object",
      "required": [
        "push"
      ],
      "properties": {
        "push": {
          "type": "object",
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        }
      }
    },
    "jobs": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "object",
          "required": [
            "steps"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "uses": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}