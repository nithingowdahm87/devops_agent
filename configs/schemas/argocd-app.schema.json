{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ArgoCD Application Schema (Hardened)",
    "type": "object",
    "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
    ],
    "properties": {
        "apiVersion": {
            "type": "string",
            "const": "argoproj.io/v1alpha1"
        },
        "kind": {
            "type": "string",
            "const": "Application"
        },
        "spec": {
            "type": "object",
            "required": [
                "destination",
                "project",
                "source",
                "syncPolicy"
            ],
            "properties": {
                "destination": {
                    "type": "object",
                    "required": [
                        "namespace"
                    ]
                },
                "syncPolicy": {
                    "type": "object",
                    "required": [
                        "automated"
                    ],
                    "properties": {
                        "automated": {
                            "type": "object",
                            "required": [
                                "prune",
                                "selfHeal"
                            ]
                        }
                    }
                }
            }
        }
    }
}